local function makeButton(name, text)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(1, 0, 0, 42)
    btn.BackgroundColor3 = Color3.fromRGB(38, 38, 48)
    btn.Text = text .. "  |  OFF"
    btn.TextColor3 = Color3.fromRGB(140, 140, 160)
    btn.TextSize = 14
    btn.Font = Enum.Font.GothamBold
    btn.AutoButtonColor = false
    btn.Parent = ButtonsFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(55, 55, 70)
    stroke.Thickness = 1.2
    stroke.Parent = btn

    return btn, stroke
end

local spinBtn, spinStroke = makeButton("spin pet", "Spin pet")
local coinBtn, coinStroke = makeButton("inf coin", "Inf Season Coins")
local trainBtn, trainStroke = makeButton("X100 tra", "X100 Train")

-- Toggle helper
local function setState(btn, stroke, state, label)
    if state then
        btn.Text = label .. "  |  ON"
        btn.TextColor3 = Color3.fromRGB(100, 220, 130)
        stroke.Color = Color3.fromRGB(100, 220, 130)
    else
        btn.Text = label .. "  |  OFF"
        btn.TextColor3 = Color3.fromRGB(140, 140, 160)
        stroke.Color = Color3.fromRGB(55, 55, 70)
    end
end

