-- ==================== REMOTES ====================
local DS = ReplicatedStorage:WaitForChild("Remote"):WaitForChild("Dungeon_Server")
local LuckPetRF = ReplicatedStorage:WaitForChild("Remote"):WaitForChild("Season_Server"):WaitForChild("LuckPetRF")
local TrainRE = ReplicatedStorage:WaitForChild("Remote"):WaitForChild("Train_Server"):WaitForChild("IntoAutoTrainRE")

-- ==================== CONFIG ====================
local Config = {
    Dungeon = false,
    Spin = false,
    Train = false,
    Rounds = 0
}

-- ==================== FUNCTIONS ====================
local function autoKillLoop()
    local hp = player:FindFirstChild("HPValue")
    if hp and hp:IsA("ValueBase") then
        hp.Value = math.huge
        hp:SetAttribute("MaxHP", math.huge)
    end

    while Config.Dungeon do
        local EnemyFolder = Workspace:FindFirstChild("EnemyFolder")
        if EnemyFolder then
            for _, enemy in pairs(EnemyFolder:GetChildren()) do
                local hpValue = enemy:FindFirstChild("HPValue")
                if hpValue and hpValue:IsA("ValueBase") and hpValue.Value > 0 then
                    hpValue.Value = 0
                end
            end
        end
        task.wait(0.05)
    end
end

local function farmLoop()
    while Config.Dungeon do
        task.spawn(function()
            pcall(function() DS.TryClaimDailyDunTicRE:FireServer() end)
            pcall(function() DS.TryIntoDungeonRF:InvokeServer(true, 50) end)
        end)

        local done = false
        for _ = 1, 5 do
            task.spawn(function()
                while not done and Config.Dungeon do
                    local success, result = pcall(function()
                        DS.StartRoundRE:FireServer(50)
                        return DS.CompleteRoundRF:InvokeServer(50)
                    end)
                    if not success or type(result) ~= "table" then
                        done = true
                        break
                    end
                    Config.Rounds += 1
                end
            end)
        end
        repeat task.wait() until done or not Config.Dungeon
    end
end

local function spinLoop()
    while Config.Spin do
        pcall(function()
            LuckPetRF:InvokeServer()
        end)
        task.wait(0.03)
    end
end

local function trainLoop()
    while Config.Train do
        pcall(function()
            TrainRE:FireServer(9, true)
        end)
        task.wait(0.1)
    end
end

